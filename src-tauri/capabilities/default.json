{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default window permissions",
  "windows": [
    "main",
    "ai-hub"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "opener:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-start-dragging",
    "core:window:allow-create",
    "core:window:allow-center",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "autostart:default",
    "window-state:default",
    "global-shortcut:default",
    "notification:default",
    "updater:default",
    "allow-get-system-info",
    "allow-fetch-ical",
    "allow-open-url",
    "allow-bilibili-search",
    "allow-geocode-city",
    "allow-reverse-geocode",
    "allow-fetch-weather-forecast",
    "allow-toggle-main-window",
    "allow-set-autostart",
    "allow-register-global-hotkey",
    "allow-send-notification",
    "allow-start-sensor-service",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-dismiss-pending-update",
    "allow-restart-app",
    "allow-toggle-immersive-fullscreen",
    "allow-is-immersive-fullscreen",
    "allow-open-ai-hub",
    "allow-create-or-update-ai-webview",
    "allow-take-ai-hub-pending-tab"
  ]
}
